PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://root:password@localhost:3306/campus_canteen"
JWT_SECRET="your_secret_key"
JWT_EXPIRES_IN="7d"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="user"
SMTP_PASS="pass"

# Limit threads spawned by Prisma's Tokio runtime to prevent OS Error 11 (Resource temporarily unavailable)
# under strict cPanel NPROC limits (25 processes/threads max).
TOKIO_WORKER_THREADS=1

